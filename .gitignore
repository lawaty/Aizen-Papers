.env
.venv/
__pycache__/
*.pyc
test curl.txt
template_state.json
poll_state.json
poll_state.stub.json
poll_state.json.lock
stub_invoices.json
# Payments pipeline artifacts. Machine-specific for the same reason as the
# invoice ones: uploading a payments state file would mark real payments as
# already confirmed, silently suppressing deliveries.
poll_payments_state.json
poll_payments_state.stub.json
poll_payments_state.json.lock
stub_payments.json
poll_customers_state.json
poll_customers_state.stub.json
poll_customers_state.json.lock
stub_customers.json
# Lock sidecars for every pipeline's state file, including the stub ones a
# hand-run poll can leave behind.
poll_payments_state*.json.lock
poll_customers_state*.json.lock
poll_state*.json.lock
# The send report holds customer PII (names, amounts, recipient numbers) and is
# browsable from a web root; it belongs on this list like every other artifact.
reports/
reports.stub/
webhook_events.jsonl
*.bak
# Rendered sample header PDF for Meta template review (regenerated on demand).
meta_sample_invoice.pdf
# Vendored pure-Python dependencies for hosts without pip; regenerated with
# tools/build_vendor.py, not source.
vendor/
# Local handoff notes; machine/credential context, never commit.
HANDOFF-*.md
# Per-day poll logs written by tools/run_poll.sh; they contain customer
# invoice ids, never commit. The .gitkeep keeps the directory present.
logs/*
!logs/.gitkeep
# Legacy unbounded cron log (pre-run_poll.sh); server-side only.
poll.log