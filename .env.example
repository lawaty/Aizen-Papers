# --- Daftra ERP ---
# Authentication uses the Daftra API key sent as the `apikey` header — the
# simplest supported method. The key must have the required permissions enabled
# in the Daftra web UI (Settings -> API -> API Key); a key with no effective
# permissions returns 401 Unauthorized.
DAFTRA_API_KEY=your_daftra_api_key
# Use your account-specific API root, for example:
# https://your-account.daftra.com/api2
DAFTRA_BASE_URL=https://your-account.daftra.com/api2
DAFTRA_TIMEOUT=15

# --- Second Daftra app (optional, for the poll command) ---
# The poll command watches every configured app in order. App 1 uses the
# unprefixed vars above; extra apps use numbered slots (DAFTRA2_*, DAFTRA3_*,
# ...). Slots 2-9 are scanned; a slot with no *_BASE_URL or no *_API_KEY is
# skipped, and a gap (an empty slot before a configured one) logs a warning
# instead of dropping the later app. The app name (used in logs and as the
# state-file key) defaults to the account subdomain, or set it explicitly.
# Two apps with the same name would share poll state and are warned about.
# DAFTRA2_BASE_URL=https://second-account.daftra.com/api2
# DAFTRA2_API_KEY=your_second_daftra_api_key
# DAFTRA2_TIMEOUT=15
# DAFTRA_APP2_NAME=second-account

# --- Polling (auto-send new invoices) ---
# Seconds between poll cycles.
POLL_INTERVAL=60
# JSON file recording which invoices were already handled, per app (gitignored).
POLL_STATE_PATH=poll_state.json
# List page size per cycle. Paging continues only while a page comes back full and
# its last row is unseen, bounded by POLL_MAX_PAGES, so this sets how far back a
# busy account stays reachable — a tenant with more invoices than this * max pages
# leaves its oldest ones permanently unseen. 50 covers the largest account here.
POLL_LIMIT=50
# Most recent seen invoice ids kept per app in the state file (bounded growth).
POLL_MAX_SEEN=500
# Cap (seconds) on the retryable-failure backoff. Retryable failures
# (network/timeout, HTTP 429, HTTP 5xx) are never given up; permanent failures
# (validation, missing public_url, template rejection, self-send) are given up
# on the first attempt and recorded as "abandoned" in the state.
POLL_MAX_BACKOFF=3600
# Max list pages fetched per cycle when the page is saturated (catch-up paging).
POLL_MAX_PAGES=5

# --- Offline stub demo (poll --stub) ---
# Persistent fixture queue and poll state for the offline demo, kept separate
# from the real poll_state.json (both gitignored).
STUB_INVOICES_PATH=stub_invoices.json
POLL_STUB_STATE_PATH=poll_state.stub.json

# --- Meta WhatsApp Business Cloud API (test mode) ---
# System User token from Meta Business Manager (whatsapp_business_messaging permission)
WHATSAPP_ACCESS_TOKEN=EAAG...your_token_here
WHATSAPP_PHONE_NUMBER_ID=1240897699116446
WHATSAPP_API_VERSION=v25.0
# Must be an APPROVED template. Body placeholders {{1}}..{{4}} map to
# InvoiceTemplateBuilder.parameters() (customer, invoice no, date, total). While a
# revision is under review the account keeps serving the last approved structure:
# the currently approved revision is a clean TEXT header (no document, body-only),
# and the DOCUMENT-header revision under review will restore PDF attachment once
# approved. The document itself is supplied by INVOICE_ATTACHMENT above. The
# language code must match an active translation (registered as en).
# Use the exact template name from WhatsApp Manager (e.g. aizen_invoice).
WHATSAPP_TEMPLATE_NAME=aizen_invoice
# Language code must match an approved translation of the template (e.g. en)
WHATSAPP_TEMPLATE_LANG=en
# While the template is unusable (a send rejected with a 132000-series code, e.g.
# 132001 "no template for the language en"), fall back to a FREE-FORM message so
# the pipeline still works end to end. The fallback reuses the PDF that the
# rejected send already uploaded (or sends the same text as `send --freeform`).
# HARD LIMIT: Meta only delivers free-form messages inside the 24-hour customer
# service window — outside it the fallback is rejected with 131047 and the invoice
# stays pending. This is a bridge, not a delivery mode: it stops firing as soon as
# the template contract works (approved aizen_invoice with a translation whose
# code matches WHATSAPP_TEMPLATE_LANG exactly). Set to off/0/false/no to keep
# template sends only. See docs/guide/template-contract.md.
WHATSAPP_FREEFORM_FALLBACK=true
WHATSAPP_TIMEOUT=15
# Cap (seconds) on the 429 Retry-After wait honored inside one send attempt.
# Meta can ask for a long wait (Retry-After: 3600); an unbounded sleep inside a
# `poll --once` run would hold the poll-state lock and block later cron runs, so
# the wait is capped and the next cycle retries instead.
WHATSAPP_MAX_RETRY_WAIT=30
# The business number that owns this WhatsApp Business Account. Sending a message
# to your own number is rejected by Meta (#100/131021 "Recipient cannot be sender"),
# so this is blocked before the POST. Optional: if empty, it is resolved once from
# the Graph API (fields=display_phone_number).
WA_OWN_NUMBER=201280805534

# --- Delivery-status webhook (diagnostics) ---
# WhatsApp Business Account id that owns the phone number above.
WHATSAPP_WABA_ID=
# Verify token paired with the callback URL registered in the Meta App
# Dashboard (developers.facebook.com -> app -> WhatsApp -> Configuration).
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-token

# --- Template auto-switching ---
# Builder selection: auto resolves once per WHATSAPP_TEMPLATE_TTL seconds against
# the template status. PENDING keeps the last approved structure; APPROVED with a
# DOCUMENT header selects the attachment-carrying builder (PDF), APPROVED with a
# clean TEXT header selects the body-only builder. legacy/new pin a builder.
WHATSAPP_TEMPLATE_BUILDER=auto
# JSON file caching the resolved template state (gitignored).
WHATSAPP_TEMPLATE_CACHE=template_state.json
# Cache TTL in seconds before the template status is re-fetched.
WHATSAPP_TEMPLATE_TTL=300

# --- Invoice PDF attachment ---
# How the invoice PDF reaches the customer as the template's header document.
#   upload (default) - render the PDF here and upload it to Meta; the header then
#                      references the returned media id. Needs nothing from you,
#                      and is the only mode that works with Daftra, whose
#                      invoice_pdf_url is session-gated.
#   link             - point Meta at a publicly reachable PDF. Only useful if you
#                      host the file yourself; Daftra's own url is behind a login.
#   none             - send without a header document.
# Overridable per run with `sender send|preview|poll --attachment <mode>`.
INVOICE_ATTACHMENT=upload
# Optional caption for the document. Leave empty: Meta's reference states that
# document captions are not supported for the document header parameter, so this
# is opt-in and only worth setting if you have verified it works for your
# template revision.
INVOICE_ATTACHMENT_CAPTION=

# --- Behaviour ---
# Country code prepended to local-format Daftra numbers (e.g. 01027693262 -> 201027693262).
# Leave empty to disable conversion.
DEFAULT_COUNTRY_CODE=20
WHATSAPP_DRY_RUN=false
LOG_LEVEL=INFO