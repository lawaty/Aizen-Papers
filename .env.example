# --- Daftra ERP (Settings > API in your Daftra account) ---
DAFTRA_API_KEY=your_daftra_api_key_here
# If api.daftra.com does not resolve for your account, use your account subdomain,
# e.g. https://your-account.daftra.com/api2 (the v2 API lives under /api2)
DAFTRA_BASE_URL=https://api.daftra.com/api2
DAFTRA_TIMEOUT=15

# --- Meta WhatsApp Business Cloud API (test mode) ---
# System User token from Meta Business Manager (whatsapp_business_messaging permission)
WHATSAPP_ACCESS_TOKEN=EAAG...your_token_here
WHATSAPP_PHONE_NUMBER_ID=1240897699116446
WHATSAPP_API_VERSION=v25.0
# Must be an APPROVED template whose body placeholders {{1}}..{{4}} match
# InvoiceTemplateBuilder.parameters() order (customer, invoice no, date, total).
# Use the exact template name from WhatsApp Manager (e.g. aizen_invoice).
WHATSAPP_TEMPLATE_NAME=aizen_invoice
# Language code must match an approved translation of the template (e.g. en, en_US)
WHATSAPP_TEMPLATE_LANG=en_EG
WHATSAPP_TIMEOUT=15

# --- Behaviour ---
# Country code prepended to local-format Daftra numbers (e.g. 01027693262 -> 201027693262).
# Leave empty to disable conversion.
DEFAULT_COUNTRY_CODE=20
WHATSAPP_DRY_RUN=false
LOG_LEVEL=INFO